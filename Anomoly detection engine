import numpy as np
import pandas as pd
from sklearn.ensemble import IsolationForest
from sklearn.preprocessing import StandardScaler
from collections import deque

def build_features(df):
    df = df.copy()
    df["salary_pct_change"] = df.groupby("employee_id")["salary"].pct_change()
    df["ot_ratio"] = df["overtime_hours"] / (df["total_hours"] + 1e-6)
    df["salary_rolling_mean"] = (
        df.groupby("employee_id")["salary"]
        .rolling(window=3, min_periods=1)
        .mean()
        .reset_index(level=0, drop=True)
    )
    df["ot_rolling_std"] = (
        df.groupby("employee_id")["overtime_hours"]
        .rolling(window=7, min_periods=1)
        .std()
        .reset_index(level=0, drop=True)
        .fillna(0)
    )
    return df[
        [
            "salary_pct_change",
            "ot_ratio",
            "salary_rolling_mean",
            "ot_rolling_std",
        ]
    ].fillna(0)

class AnomalyEngine:
    def __init__(self, window_size=90):
        self.window_size = window_size
        self.buffer = deque(maxlen=window_size)
        self.scaler = StandardScaler()
        self.model = IsolationForest(
            n_estimators=200,
            contamination="auto",
            random_state=42,
        )

    def train(self, X):
        Xs = self.scaler.fit_transform(X)
        self.model.fit(Xs)

    def retrain_if_needed(self):
        if len(self.buffer) == self.window_size:
            X = np.array(self.buffer)
            self.train(X)

    def score(self, x):
        xs = self.scaler.transform([x])
        return -self.model.score_samples(xs)[0]

def population_stability_index(expected, actual, bins=10):
    expected_pct, _ = np.histogram(expected, bins=bins)
    actual_pct, _ = np.histogram(actual, bins=bins)
    expected_pct = expected_pct / len(expected)
    actual_pct = actual_pct / len(actual)
    return np.sum(
        (actual_pct - expected_pct)
        * np.log((actual_pct + 1e-6) / (expected_pct + 1e-6))
    )

engine = AnomalyEngine(window_size=90)

def process_event(event_row):
    features = build_features(event_row).iloc[0].values
    engine.buffer.append(features)
    engine.retrain_if_needed()
    score = engine.score(features)
    threshold = (
        np.percentile(
            [engine.score(x) for x in engine.buffer],
            98,
        )
        if len(engine.buffer) > 20
        else np.inf
    )
    return {"alert": score > threshold, "score": score}

def batch_train(payroll_df):
    X = build_features(payroll_df)
    engine.train(X.values)
    engine.buffer.extend(X.values)

def inject_anomalies(df):
    df = df.copy()
    idx = np.random.choice(len(df), size=int(0.02 * len(df)))
    df.loc[idx, "overtime_hours"] *= 4
    df.loc[idx, "salary"] *= 1.5
    return df
